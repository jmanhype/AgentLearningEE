# Agent Learning EE - Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# =============================================================================
# LLM API Configuration (REQUIRED)
# =============================================================================

# OpenRouter (Recommended - supports multiple models)
OPENAI_API_KEY=sk-or-v1-your-api-key-here
OPENAI_API_BASE=https://openrouter.ai/api/v1

# OR OpenAI (Alternative)
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_API_BASE=https://api.openai.com/v1

# =============================================================================
# ACE Playbook Configuration (Optional)
# =============================================================================

# Enable/disable ACE integration (1 = enabled, 0 = disabled)
ACE_ENABLED=1

# ACE playbook domain identifier
ACE_DOMAIN_ID=default

# ACE deployment stage (shadow/staging/prod)
ACE_TARGET_STAGE=shadow

# ACE sections to use for playbook context
# ACE_SECTIONS=Helpful,Harmful

# ACE token budget for playbook context
# ACE_TOKEN_BUDGET=1000

# =============================================================================
# Training Configuration (Optional)
# =============================================================================

# Number of exploration rollouts per demonstration
# NUM_ROLLOUTS=10

# Number of alternative actions to generate
# NUM_ALTERNATIVES=3

# Model temperature for generation
# TEMPERATURE=0.7
