# ACE Integration Configuration
# Source this file: source .env.ace

# Enable ACE integration
export ACE_ENABLED=1

# Domain configuration
export ACE_DOMAIN_ID="agent-learning"

# Stage management (shadow/staging/prod)
export ACE_TARGET_STAGE="shadow"

# Similarity threshold for FAISS deduplication (0.0-1.0)
export ACE_SIMILARITY_THRESHOLD="0.80"

# Token budget for playbook context (tokens)
export ACE_TOKEN_BUDGET="3500"

# ACE sections to include (optional, comma-separated)
# export ACE_SECTIONS="Helpful,Harmful"

# Database URL for ACE (defaults to SQLite)
export DATABASE_URL="sqlite:///ace_playbook.db"

# Add ACE repo to Python path
export PYTHONPATH="/Users/speed/ace-playbook:$PYTHONPATH"
